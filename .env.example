# ── LLM providers ────────────────────────────────────────────────────────────
# Add at least one key. The factory auto-discovers any variable that starts
# with a supported prefix. Add a suffix to register extra keys, for example:
#   GROQ_API_KEY_1=...
#   GROQ_API_KEY_2=...
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OMNIROUTE_API_KEY=

# ── Local Ollama (optional) ──────────────────────────────────────────────────
# Ollama is never used automatically. Set to 1 to allow the fallback.
ENABLE_OLLAMA=0

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Needed for github_create_issue; recommended for code search rate limits.
GITHUB_TOKEN=

# ── Langfuse tracing (optional) ──────────────────────────────────────────────
ENABLE_LANGFUSE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Runtime overrides (optional) ─────────────────────────────────────────────
# Provider: auto, openai, groq, gemini, omniroute, ollama
KRATOS_MODEL=auto

# Set to 1 to auto-approve tool prompts (trusted automation only).
# KRATOS_YES=1
